#include <winver.h>
IDI_ICON1 ICON "afd.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION AFD_APP_MAJOR,AFD_APP_MINOR,AFD_APP_PATCH,0
 PRODUCTVERSION AFD_APP_MAJOR,AFD_APP_MINOR,AFD_APP_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Local archive and email inspection workstation"
   VALUE "FileVersion", AFD_VERSION
   VALUE "InternalName", "alternativefastdelivery"
   VALUE "OriginalFilename", "alternativefastdelivery.exe"
   VALUE "ProductName", "AlternativeFastDelivery"
   VALUE "ProductVersion", AFD_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
